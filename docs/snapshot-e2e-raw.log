  Web A={"id": "color_01", "bg": "rgb(94, 53, 177)"}  Web B={"id": "color_01", "bg": "rgb(94, 53, 177)"}
  PC 壳页={"id": "color_01", "bg": "rgb(94, 53, 177)"}
