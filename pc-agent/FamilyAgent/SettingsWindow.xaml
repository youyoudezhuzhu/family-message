<Window x:Class="FamilyAgent.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="家庭消息 · Family Agent"
        Width="620" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#12151C"
        MinWidth="520" MinHeight="560">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FA0BC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1B2130"/>
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="BorderBrush" Value="#2A3243"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#243044"/>
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#32425C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,22">
            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#F2705E"
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="StatusText" Text="未连接" FontSize="20"
                       Foreground="#E8EDF7" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="服务端地址（NAS 的 IP + 端口）"/>
            <TextBox x:Name="ServerBox" Text="http://192.168.31.50:18801"/>

            <TextBlock Text="设备名称（显示在网页控制台上的名字）"/>
            <TextBox x:Name="NameBox"/>

            <TextBlock Text="设备 ID（同一台机器保持固定即可）"/>
            <TextBox x:Name="IdBox"/>

            <TextBlock Text="注册口令（服务端 config.yaml 里的 device.enroll_token）"/>
            <TextBox x:Name="EnrollBox"/>

            <CheckBox x:Name="AutoStartBox" Content="Windows 启动时自动运行"
                      Foreground="#E8EDF7" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="HintText" Text=""
                   Foreground="#5C6B85" TextWrapping="Wrap"
                   VerticalAlignment="Bottom" Margin="0,20,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,22,0,0">
            <Button x:Name="SaveButton" Content="保存并连接" Background="#5AC8FA"
                    Foreground="#06121C" Click="SaveButton_Click"/>
            <Button x:Name="TestButton" Content="测试连接" Click="TestButton_Click"/>
            <Button x:Name="ConsoleButton" Content="打开控制台" Click="ConsoleButton_Click"/>
            <Button x:Name="HideButton" Content="最小化到托盘" Click="HideButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
