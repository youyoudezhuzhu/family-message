<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FamilyAgent</AssemblyName>
    <RootNamespace>FamilyAgent</RootNamespace>
    <Version>0.12.1</Version>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 声明 PerMonitorV2 DPI 感知（见同目录 app.manifest）。
         不声明的话高缩放屏上整个界面会被 Windows 位图放大 = 糊 + 拉伸。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ThemeMode 是 WPF 的 experimental API，用代码访问会报 WPF0001，这里抑制掉 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- 单文件发布时把 native 库解压出来自取：WebView2 的 native loader
         （WebView2Loader.dll）就靠它，关掉的话壳起不来。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 界面不再是 WPF 手绘：整个窗口就是这一块 WebView2，加载服务端的网页端页面
         （壳模式，见 docs/PC-WEBVIEW2-REWRITE.md）。
         ★ 版本固定，不用 `*` 浮动版本：云编译的产物要可复现。
         Windows 11 自带 WebView2 Runtime；Windows 10 缺运行时由壳自检并给出官方下载链接。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本地兜底页（boot.html 首屏 / offline.html 连不上服务端 / 缺运行时的提示）随 exe 发布：
         源文件由网页端那边维护（web/shell/），这里只负责复制到输出的 shell/ 下。
         壳从 <exe 目录>/shell/ 通过虚拟域名 https://familyagent.local/shell/ 读它们。
         文件暂时不存在时通配符展开为空，不算错误 —— 壳会退化成「只加载正式页面」。 -->
    <Content Include="..\..\web\shell\**\*.html" Link="shell\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
