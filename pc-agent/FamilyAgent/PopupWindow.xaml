<Window x:Class="FamilyAgent.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FamilyAgent"
        Title="家庭消息"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource MdSurface}" FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <!-- 这里**故意留空**。
             以前这里堆了一整套手写的 ControlTemplate（按钮/输入框/下拉/勾选框/
             滚动条），那正是三个 bug 的来源：
               1) 改共享画刷的 Color → 撞上 WPF 的 Freeze 机制崩溃
               2) 给 CornerRadius 传 double 常量 → 运行期拆箱失败，窗口打不开
               3) 拿按钮的全圆角样式做色块方块 → 变成椭圆
             现在控件样式统一交给 WPF 内置的 Fluent 主题（见 App.xaml.cs 的
             ThemeMode），这里不再维护任何模板。 -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════ 顶部应用栏 ══════ -->
        <Border Grid.Row="0" Background="{DynamicResource MdSurfaceLow}"
                BorderBrush="{DynamicResource MdOutlineVariant}"
                BorderThickness="0,0,0,1" Padding="56,0,32,0" Height="64">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <!-- Material 图标：chat（规范 §10 —— 不用 emoji 当 UI 图标）-->
                    <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
                          Fill="{DynamicResource MdPrimary}"
                          Width="26" Height="26" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="家庭消息"
                               FontSize="{x:Static local:MdTheme.FontTitleLarge}"
                               FontWeight="Normal"
                               Foreground="{DynamicResource MdOnSurface}"
                               VerticalAlignment="Center"/>
                    <Border x:Name="CountBadge" Background="{DynamicResource MdPrimaryContainer}"
                            CornerRadius="8" Padding="9,2" Margin="14,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="CountText" Text="1 条新消息"
                                   FontSize="{x:Static local:MdTheme.FontLabelSmall}"
                                   Foreground="{DynamicResource MdOnPrimaryContainer}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource MdBad}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="未连接"
                               FontSize="{x:Static local:MdTheme.FontLabelMedium}"
                               Foreground="{DynamicResource MdOnVariant}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="SettingsButton"
                            Margin="0" Padding="12,0" Height="40" Click="SettingsButton_Click"
                            ToolTip="设置">
                        <Path Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"
                              Fill="{DynamicResource MdOnVariant}"
                              Width="22" Height="22" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════ 消息区（右侧历史弹幕已移除：与网页端消息记录重复）══════ -->
        <!-- 宽屏（2K/4K）上限制内容宽度：不加限制的话消息会横跨两千多像素，
             一行字长得没法读，视觉上就是「整个 MD 布局被拉伸了」。 -->
        <Grid Grid.Row="1" Margin="56,20,40,32" MaxWidth="1180" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="MessageScroll" Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,8,0">
                <StackPanel x:Name="MessageStack" VerticalAlignment="Bottom"/>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="ReplyNameBox" Grid.Column="0"
                             
                              MinWidth="132" Margin="0,0,12,0"
                              VerticalContentAlignment="Center"
                              SelectionChanged="ReplyNameBox_SelectionChanged"/>

                    <TextBox x:Name="ReplyBox" Grid.Column="1"
                             FontSize="{x:Static local:MdTheme.FontTitleMedium}"
                             Padding="16,12" Margin="0"
                             MaxLength="2000" AcceptsReturn="False"
                             KeyDown="ReplyBox_KeyDown"/>

                    <Button x:Name="SendButton" Grid.Column="2" IsDefault="True"
                           
                            Margin="12,0,0,0" Padding="26,0"
                            FontSize="{x:Static local:MdTheme.FontLabelLarge}"
                            Click="SendButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                                  Fill="{DynamicResource MdOnPrimary}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="回复" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OkButton" Grid.Column="0" IsCancel="True"
                            Margin="0"
                            Padding="28,0" Height="40"
                            FontSize="{x:Static local:MdTheme.FontLabelLarge}"
                            Click="OkButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                  Fill="{DynamicResource MdPrimary}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="关闭窗口" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="HintText" Grid.Column="1" Text="Enter 直接回复"
                               FontSize="{x:Static local:MdTheme.FontBodyMedium}"
                               Foreground="{DynamicResource MdOnVariant}"
                               VerticalAlignment="Center" Margin="20,0,0,0"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ══════ 设置页（MD 对话框覆盖层）══════ -->
        <Grid x:Name="SettingsPage" Grid.RowSpan="2" Visibility="Collapsed"
              Background="{DynamicResource MdScrim}">
            <Border Width="780" MaxHeight="920" CornerRadius="28"
                    Background="{DynamicResource MdSurfaceHigh}"
                    VerticalAlignment="Center" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="设置"
                                   FontSize="{x:Static local:MdTheme.FontTitleLarge}"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource MdOnSurface}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Ellipse x:Name="SettingsDot" Width="10" Height="10"
                                     Fill="{DynamicResource MdBad}" VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="SettingsStatus" Text="未连接"
                                       FontSize="{x:Static local:MdTheme.FontLabelMedium}"
                                       Foreground="{DynamicResource MdOnVariant}"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <!-- 外观：明暗模式（规范 §5）-->
                            <TextBlock Text="外观（默认跟随系统）"
                                      />
                            <UniformGrid x:Name="ModeGrid" Columns="3" Margin="0,4,0,0"/>

                            <Border Height="1" Background="{DynamicResource MdOutlineVariant}"
                                    Margin="0,20,0,20"/>

                            <!-- 配色方案选择器已移除：面板颜色现在直接跟随
                                 Windows 的 Fluent 主题（含系统主题色），
                                 不再由我们自己算一套配色 —— 那正是"Fluent 不够彻底"的根源。 -->

                            <!-- 连接配置 -->
                            <TextBlock Text="服务端地址（NAS 的 IP + 端口）"
                                      />
                            <TextBox x:Name="ServerBox"/>

                            <TextBlock Text="设备名称（显示在网页控制台上的名字）"
                                      />
                            <TextBox x:Name="NameBox"/>

                            <TextBlock Text="设备 ID（同一台机器保持固定即可）"
                                      />
                            <TextBox x:Name="IdBox"/>

                            <TextBlock Text="注册口令（服务端 config.yaml 里的 device.enroll_token）"
                                      />
                            <TextBox x:Name="EnrollBox"/>

                            <!-- 开机自启 -->
                            <CheckBox x:Name="AutoStartBox"
                                      Content="Windows 启动时自动运行" Margin="0,4,0,20"/>

                            <!-- 回复昵称 -->
                            <TextBlock Text="回复昵称（本机使用，可随时增删改；消息颜色按昵称分配）"
                                      />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewReplyNameBox" Grid.Column="0"
                                         Margin="0,0,10,0"
                                         Padding="14,11"/>
                                <Button Grid.Column="1" Content="添加" Height="42"
                                        Margin="0"
                                        Padding="22,0" Click="AddReplyName_Click"/>
                            </Grid>
                            <StackPanel x:Name="ReplyNamesPanel"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <TextBlock x:Name="SettingsHint" Text=""
                                   FontSize="{x:Static local:MdTheme.FontBodySmall}"
                                   Foreground="{DynamicResource MdOnVariant}"
                                   TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="保存并连接"
                                    Click="SaveSettings_Click"/>
                            <Button Content="测试连接"
                                    Click="TestConnection_Click"/>
                            <Button Content="打开控制台"
                                    Click="OpenConsole_Click"/>
                            <Button Content="打开日志"
                                    Click="OpenLog_Click"/>
                            <Button Content="返回消息"
                                    Click="CloseSettings_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
