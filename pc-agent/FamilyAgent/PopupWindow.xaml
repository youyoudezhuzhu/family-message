<Window x:Class="FamilyAgent.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FamilyAgent"
        Title="家庭消息"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Background="{x:Static local:MdTheme.Surface}">

    <Window.Resources>

        <!-- ══ MD 滚动条：细、无轨道底、圆头 ══════════════════
             默认 WPF 滚动条带白色轨道和箭头按钮，暗色下非常刺眼，
             只设属性改不了，必须整体替换模板。 -->
        <Style x:Key="MdThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="B" Background="{x:Static local:MdTheme.ScrollThumb}"
                                                CornerRadius="{x:Static local:MdTheme.RadiusFull}" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{x:Static local:MdTheme.ScrollThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{x:Static local:MdTheme.Outline}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MdThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══ MD 按钮 ══════════════════════════════════════ -->
        <Style x:Key="MdBase" TargetType="Button">
            <Setter Property="Foreground" Value="{x:Static local:MdTheme.Primary}"/>
            <Setter Property="FontSize" Value="{x:Static local:MdTheme.FontLabelLarge}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" CornerRadius="999"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background"
                                        Value="{x:Static local:MdTheme.StateHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MdFilled" TargetType="Button" BasedOn="{StaticResource MdBase}">
            <Setter Property="Background" Value="{x:Static local:MdTheme.Primary}"/>
            <Setter Property="Foreground" Value="{x:Static local:MdTheme.OnPrimary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="MdOutlined" TargetType="Button" BasedOn="{StaticResource MdBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{x:Static local:MdTheme.Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{x:Static local:MdTheme.Primary}"/>
        </Style>

        <Style x:Key="MdText" TargetType="Button" BasedOn="{StaticResource MdBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <!-- ══ MD 输入框（outlined）═════════════════════════ -->
        <Style x:Key="MdTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{x:Static local:MdTheme.SurfaceC}"/>
            <Setter Property="Foreground" Value="{x:Static local:MdTheme.OnSurface}"/>
            <Setter Property="CaretBrush" Value="{x:Static local:MdTheme.Primary}"/>
            <Setter Property="FontSize" Value="{x:Static local:MdTheme.FontBodyLarge}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Shell" CornerRadius="{x:Static local:MdTheme.RadiusExtraSmall}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{x:Static local:MdTheme.Outline}"
                                BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush"
                                        Value="{x:Static local:MdTheme.Primary}"/>
                                <Setter TargetName="Shell" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ MD 下拉（默认模板在暗色下浮层纯白，必须整套换掉）══ -->
        <Style x:Key="MdCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{x:Static local:MdTheme.OnSurface}"/>
            <Setter Property="FontSize" Value="{x:Static local:MdTheme.FontBodyLarge}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{x:Static local:MdTheme.SurfaceC}"
                                                BorderBrush="{x:Static local:MdTheme.Outline}"
                                                BorderThickness="1" CornerRadius="{x:Static local:MdTheme.RadiusExtraSmall}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="14,10,0,10"
                                                                  VerticalAlignment="Center"/>
                                                <Path Grid.Column="1" Data="M 0 0 L 5 5 L 10 0"
                                                      Stroke="{x:Static local:MdTheme.OnVariant}"
                                                      StrokeThickness="1.6" Margin="10,0,14,0"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush"
                                                        Value="{x:Static local:MdTheme.Primary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  TextElement.Foreground="{x:Static local:MdTheme.OnSurface}"
                                                  TextElement.FontSize="{x:Static local:MdTheme.FontBodyLarge}"
                                                  VerticalAlignment="Center"/>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{x:Static local:MdTheme.SurfaceHigh}"
                                        BorderBrush="{x:Static local:MdTheme.OutlineVariant}"
                                        BorderThickness="1"
                                        CornerRadius="{x:Static local:MdTheme.RadiusExtraSmall}"
                                        MinWidth="{Binding ActualWidth,
                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="300" Margin="0,4,0,0">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{x:Static local:MdTheme.OnSurface}"/>
                        <Setter Property="FontSize" Value="{x:Static local:MdTheme.FontBodyLarge}"/>
                        <Setter Property="Padding" Value="16,12"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemChrome" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background"
                                                    Value="{x:Static local:MdTheme.StateHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background"
                                                    Value="{x:Static local:MdTheme.PrimaryContainer}"/>
                                            <Setter Property="Foreground"
                                                    Value="{x:Static local:MdTheme.OnPrimaryContainer}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ MD 勾选框 ════════════════════════════════════ -->
        <Style x:Key="MdCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{x:Static local:MdTheme.OnSurface}"/>
            <Setter Property="FontSize" Value="{x:Static local:MdTheme.FontBodyLarge}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="{x:Static local:MdTheme.RadiusExtraSmall}"
                                    BorderBrush="{x:Static local:MdTheme.Outline}"
                                    BorderThickness="2" VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M 0 4 L 3.5 7.5 L 9 1"
                                      Stroke="{x:Static local:MdTheme.OnPrimary}"
                                      StrokeThickness="2" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background"
                                        Value="{x:Static local:MdTheme.Primary}"/>
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{x:Static local:MdTheme.Primary}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置页里的小标题 -->
        <Style x:Key="MdLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static local:MdTheme.FontLabelMedium}"/>
            <Setter Property="Foreground" Value="{x:Static local:MdTheme.OnVariant}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════ 顶部应用栏 ══════ -->
        <Border Grid.Row="0" Background="{x:Static local:MdTheme.SurfaceLow}"
                BorderBrush="{x:Static local:MdTheme.OutlineVariant}"
                BorderThickness="0,0,0,1" Padding="56,0,32,0" Height="64">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <!-- Material 图标：chat（规范 §10 —— 不用 emoji 当 UI 图标）-->
                    <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
                          Fill="{x:Static local:MdTheme.Primary}"
                          Width="26" Height="26" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="家庭消息"
                               FontSize="{x:Static local:MdTheme.FontTitleLarge}"
                               FontWeight="Normal"
                               Foreground="{x:Static local:MdTheme.OnSurface}"
                               VerticalAlignment="Center"/>
                    <Border x:Name="CountBadge" Background="{x:Static local:MdTheme.PrimaryContainer}"
                            CornerRadius="8" Padding="9,2" Margin="14,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="CountText" Text="1 条新消息"
                                   FontSize="{x:Static local:MdTheme.FontLabelSmall}"
                                   Foreground="{x:Static local:MdTheme.OnPrimaryContainer}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{x:Static local:MdTheme.Bad}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="未连接"
                               FontSize="{x:Static local:MdTheme.FontLabelMedium}"
                               Foreground="{x:Static local:MdTheme.OnVariant}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource MdText}"
                            Margin="0" Padding="12,0" Height="40" Click="SettingsButton_Click"
                            ToolTip="设置">
                        <Path Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"
                              Fill="{x:Static local:MdTheme.OnVariant}"
                              Width="22" Height="22" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════ 消息区（右侧历史弹幕已移除：与网页端消息记录重复）══════ -->
        <Grid Grid.Row="1" Margin="56,20,40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="MessageScroll" Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,8,0">
                <StackPanel x:Name="MessageStack" VerticalAlignment="Bottom"/>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="ReplyNameBox" Grid.Column="0"
                              Style="{StaticResource MdCombo}"
                              MinWidth="132" Margin="0,0,12,0"
                              VerticalContentAlignment="Center"
                              SelectionChanged="ReplyNameBox_SelectionChanged"/>

                    <TextBox x:Name="ReplyBox" Grid.Column="1" Style="{StaticResource MdTextBox}"
                             FontSize="{x:Static local:MdTheme.FontTitleLarge}"
                             Padding="18,14" Margin="0"
                             MaxLength="2000" AcceptsReturn="False"
                             KeyDown="ReplyBox_KeyDown"/>

                    <Button x:Name="SendButton" Grid.Column="2"
                            Style="{StaticResource MdFilled}"
                            Margin="12,0,0,0" Padding="32,0"
                            FontSize="{x:Static local:MdTheme.FontTitleMedium}"
                            Click="SendButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                                  Fill="{x:Static local:MdTheme.OnPrimary}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="回复" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OkButton" Grid.Column="0"
                            Style="{StaticResource MdOutlined}" Margin="0"
                            Padding="36,0" Height="48"
                            FontSize="{x:Static local:MdTheme.FontTitleMedium}"
                            Click="OkButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                  Fill="{x:Static local:MdTheme.Primary}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="关闭窗口" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="HintText" Grid.Column="1" Text="Enter 直接回复"
                               FontSize="{x:Static local:MdTheme.FontBodyMedium}"
                               Foreground="{x:Static local:MdTheme.OnVariant}"
                               VerticalAlignment="Center" Margin="20,0,0,0"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ══════ 设置页（MD 对话框覆盖层）══════ -->
        <Grid x:Name="SettingsPage" Grid.RowSpan="2" Visibility="Collapsed"
              Background="{x:Static local:MdTheme.Scrim}">
            <Border Width="780" MaxHeight="920" CornerRadius="28"
                    Background="{x:Static local:MdTheme.SurfaceHigh}"
                    VerticalAlignment="Center" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="设置"
                                   FontSize="{x:Static local:MdTheme.FontTitleLarge}"
                                   FontWeight="Normal"
                                   Foreground="{x:Static local:MdTheme.OnSurface}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Ellipse x:Name="SettingsDot" Width="10" Height="10"
                                     Fill="{x:Static local:MdTheme.Bad}" VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="SettingsStatus" Text="未连接"
                                       FontSize="{x:Static local:MdTheme.FontLabelMedium}"
                                       Foreground="{x:Static local:MdTheme.OnVariant}"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <!-- 外观：明暗模式（规范 §5）-->
                            <TextBlock Text="外观（默认跟随系统）"
                                       Style="{StaticResource MdLabel}"/>
                            <UniformGrid x:Name="ModeGrid" Columns="3" Margin="0,4,0,0"/>

                            <Border Height="1" Background="{x:Static local:MdTheme.OutlineVariant}"
                                    Margin="0,20,0,20"/>

                            <!-- 配色方案 -->
                            <TextBlock Text="配色方案（只存本机，服务端不记录）"
                                       Style="{StaticResource MdLabel}"/>
                            <UniformGrid x:Name="ThemeGrid" Columns="4" Margin="0,4,0,0"/>

                            <Border Height="1" Background="{x:Static local:MdTheme.OutlineVariant}"
                                    Margin="0,20,0,20"/>

                            <!-- 连接配置 -->
                            <TextBlock Text="服务端地址（NAS 的 IP + 端口）"
                                       Style="{StaticResource MdLabel}"/>
                            <TextBox x:Name="ServerBox" Style="{StaticResource MdTextBox}"/>

                            <TextBlock Text="设备名称（显示在网页控制台上的名字）"
                                       Style="{StaticResource MdLabel}"/>
                            <TextBox x:Name="NameBox" Style="{StaticResource MdTextBox}"/>

                            <TextBlock Text="设备 ID（同一台机器保持固定即可）"
                                       Style="{StaticResource MdLabel}"/>
                            <TextBox x:Name="IdBox" Style="{StaticResource MdTextBox}"/>

                            <TextBlock Text="注册口令（服务端 config.yaml 里的 device.enroll_token）"
                                       Style="{StaticResource MdLabel}"/>
                            <TextBox x:Name="EnrollBox" Style="{StaticResource MdTextBox}"/>

                            <!-- 开机自启 -->
                            <CheckBox x:Name="AutoStartBox" Style="{StaticResource MdCheck}"
                                      Content="Windows 启动时自动运行" Margin="0,4,0,20"/>

                            <!-- 回复昵称 -->
                            <TextBlock Text="回复昵称（本机使用，可随时增删改；消息颜色按昵称分配）"
                                       Style="{StaticResource MdLabel}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewReplyNameBox" Grid.Column="0"
                                         Style="{StaticResource MdTextBox}" Margin="0,0,10,0"
                                         Padding="14,11"/>
                                <Button Grid.Column="1" Content="添加" Height="42"
                                        Style="{StaticResource MdOutlined}" Margin="0"
                                        Padding="22,0" Click="AddReplyName_Click"/>
                            </Grid>
                            <StackPanel x:Name="ReplyNamesPanel"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <TextBlock x:Name="SettingsHint" Text=""
                                   FontSize="{x:Static local:MdTheme.FontBodySmall}"
                                   Foreground="{x:Static local:MdTheme.OnVariant}"
                                   TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="保存并连接" Style="{StaticResource MdFilled}"
                                    Click="SaveSettings_Click"/>
                            <Button Content="测试连接" Style="{StaticResource MdOutlined}"
                                    Click="TestConnection_Click"/>
                            <Button Content="打开控制台" Style="{StaticResource MdOutlined}"
                                    Click="OpenConsole_Click"/>
                            <Button Content="打开日志" Style="{StaticResource MdOutlined}"
                                    Click="OpenLog_Click"/>
                            <Button Content="返回消息" Style="{StaticResource MdText}"
                                    Click="CloseSettings_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
