<Window x:Class="FamilyAgent.WebHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="家庭消息"
        Width="1000" Height="760"
        Background="#FF202124"
        UseLayoutRounding="True">
    <!--
        这个窗口里**没有手绘界面**：整块区域就是 WebView2，界面完全由网页端页面渲染
        （壳模式，见 docs/PC-WEBVIEW2-REWRITE.md）。宿主只负责窗口形态、托盘、以及经
        JsBridge 暴露设备能力。

        唯一的例外是下面的 RuntimeHint：没装 WebView2 Runtime 时 WebView2 控件本身就是
        一块什么都渲染不出来的白板，那时候只能退回 WPF 把原因说清楚。它默认
        Visibility="Collapsed"，只有自检失败才出现。
    -->
    <Grid x:Name="Root">
        <wv2:WebView2 x:Name="Web" AllowExternalDrop="False" />

        <Border x:Name="RuntimeHint" Visibility="Collapsed" Background="#FF202124">
            <StackPanel MaxWidth="640" Margin="32"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="缺少 WebView2 运行环境"
                           FontSize="24" FontWeight="SemiBold" Foreground="#FFF3F3F3"
                           Margin="0,0,0,16" />
                <TextBlock FontSize="15" Foreground="#FFD0D0D0" TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Text="家庭消息 PC 端的界面由网页渲染，需要微软的 WebView2 Runtime。" />
                <TextBlock FontSize="15" Foreground="#FFD0D0D0" TextWrapping="Wrap"
                           Margin="0,0,0,18"
                           Text="Windows 11 自带；Windows 10 请点下面的链接下载「Evergreen 常青版引导程序」装一下，装完回到这个窗口点「重试检测」。" />
                <TextBlock FontSize="15" Margin="0,0,0,24" TextWrapping="Wrap">
                    <Hyperlink NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/#download-section"
                               RequestNavigate="RuntimeLink_RequestNavigate">
                        <Run Text="打开微软官方下载页（WebView2 Runtime）" />
                    </Hyperlink>
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RetryRuntimeButton" Content="重试检测"
                            Padding="18,6" Click="RetryRuntime_Click" />
                    <Button x:Name="QuitButton" Content="退出"
                            Padding="18,6" Margin="12,0,0,0" Click="Quit_Click" />
                </StackPanel>
                <TextBlock x:Name="RuntimeHintText" FontSize="13" Foreground="#FF9AA0A6"
                           TextWrapping="Wrap" Margin="0,20,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
