#!/bin/bash
# cmd/main — 家庭消息 运行控制
# $1: start / stop / status
#
# 重要：升级时必须由 upgrade_init 先 stop，否则旧进程会带着【旧代码】继续占着端口，
# 新进程绑不上端口就退出 —— 用户看到「应用在运行」，实际一直跟旧版本对话。
# 这里额外做一层兜底：启动前清理所有不是当前进程的端口占用者。

APP="${TRIM_APPDEST:-/var/apps/family-message/target}"
VAR="${TRIM_PKGVAR:-/vol1/@appdata/family-message}"
GNOME="${TRIM_PKGHOME:-/vol1/@apphome/family-message}"
PORT="${TRIM_SERVICE_PORT:-18801}"
LOG="$VAR/family-message.log"
PID_FILE="$VAR/family-message.pid"
PY="$GNOME/venv/bin/python"

export FM_CONFIG="${FM_CONFIG:-$GNOME/config.yaml}"
export FM_DATA_DIR="${FM_DATA_DIR:-$GNOME/data}"
export GATEWAY_SOCKET="${GATEWAY_SOCKET:-$APP/family-message.sock}"
export GATEWAY_PREFIX="${GATEWAY_PREFIX:-/app/family-message}"
export TRIM_SERVICE_PORT="$PORT"
export PYTHONPATH="$APP/server${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUNBUFFERED=1

# 当前代码版本，透传给服务端（/healthz 会报出来）。
# 这样「正在跑的到底是哪一版」一眼可查，不会再出现「升级了但没生效」的隐形故障。
FM_VERSION="${FM_VERSION:-}"
if [ -z "$FM_VERSION" ]; then
    for m in "$APP/manifest" "$APP/../manifest" \
             "$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/manifest"; do
        if [ -f "$m" ]; then
            FM_VERSION="$(grep -m1 '^version' "$m" 2>/dev/null | cut -d= -f2 | tr -d ' \"')"
            [ -n "$FM_VERSION" ] && break
        fi
    done
fi
export FM_VERSION="${FM_VERSION:-unknown}"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG" 2>/dev/null; }

check_process() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }

running() {
    if [ -f "$PID_FILE" ]; then
        pid=$(head -n1 "$PID_FILE" | tr -d '[:space:]')
        if check_process "$pid"; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

# ---------------- 陈旧进程清理 ----------------

listeners_on_port() {
    ss -lntp 2>/dev/null | grep -E "[:.]${1}[[:space:]]" \
        | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u
}

# 列出「不该活着」的本应用进程：参数是允许保留的 PID
orphan_pids() {
    local cur="$1" p
    {
        listeners_on_port "$PORT"
        pgrep -f "$APP/server/run\.py" 2>/dev/null
    } | sort -u | while read -r p; do
        [ -z "$p" ] && continue
        [ "$p" = "$cur" ] && continue
        echo "$p"
    done
}

kill_pids() {
    local pids="$1" p alive c=0
    [ -z "$pids" ] && return 0
    for p in $pids; do
        log "清理陈旧进程 $p：$(tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null | cut -c1-140)"
        kill -TERM "$p" 2>/dev/null
    done
    while [ $c -lt 10 ]; do
        alive=""
        for p in $pids; do
            check_process "$p" && alive="$alive $p"
        done
        [ -z "$alive" ] && return 0
        sleep 1
        c=$((c + 1))
    done
    for p in $pids; do
        kill -KILL "$p" 2>/dev/null
    done
    return 0
}

wait_port_free() {
    local c=0
    while [ $c -lt 10 ]; do
        [ -z "$(listeners_on_port "$PORT")" ] && return 0
        sleep 1
        c=$((c + 1))
    done
    return 1
}

# 启动成功 = 真的能响应 /healthz，而不只是「进程还活着」
wait_healthy() {
    local n=0 pid
    pid=$(head -n1 "$PID_FILE" 2>/dev/null | tr -d '[:space:]')
    while [ $n -lt 25 ]; do
        if "$PY" -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:$PORT/healthz',timeout=2)" >/dev/null 2>&1; then
            return 0
        fi
        if [ -n "$pid" ] && ! check_process "$pid"; then
            return 1
        fi
        sleep 1
        n=$((n + 1))
    done
    return 1
}

# ---------------- 启停 ----------------

start_process() {
    local cur="" stale
    running && cur=$(head -n1 "$PID_FILE" | tr -d '[:space:]')

    stale="$(orphan_pids "$cur")"
    if [ -n "$stale" ]; then
        log "启动前发现陈旧进程（$(echo "$stale" | tr '\n' ' ')），清理"
        kill_pids "$stale"
        wait_port_free || log "端口 $PORT 仍被占用，继续尝试启动"
    fi

    if [ -n "$cur" ] && check_process "$cur"; then
        log "已在运行（pid $cur, v$FM_VERSION）"
        return 0
    fi

    if [ ! -x "$PY" ]; then
        log "venv 缺失，尝试重建"
        /bin/bash "$APP/../cmd/install_callback" >/dev/null 2>&1 || true
    fi
    if [ ! -x "$PY" ]; then
        echo "Python 运行环境缺失，请在应用中心重新安装本应用。" > "$TRIM_TEMP_LOGFILE"
        return 1
    fi

    log "Starting family-message v$FM_VERSION ..."
    mkdir -p "$VAR" "$(dirname "$GATEWAY_SOCKET")"
    rm -f "$GATEWAY_SOCKET"
    cd "$APP/server" || return 1
    nohup "$PY" "$APP/server/run.py" >> "$LOG" 2>&1 &
    echo $! > "$PID_FILE"

    if wait_healthy; then
        log "family-message v$FM_VERSION started (pid $(cat "$PID_FILE"))"
        return 0
    fi

    log "family-message v$FM_VERSION start FAILED，日志: $LOG"
    echo "家庭消息服务启动失败，请查看日志：$LOG" > "$TRIM_TEMP_LOGFILE"
    return 1
}

stop_process() {
    local pid left
    if [ -f "$PID_FILE" ]; then
        pid=$(head -n1 "$PID_FILE" | tr -d '[:space:]')
        if check_process "$pid"; then
            log "Stopping family-message (pid $pid, v$FM_VERSION)"
            kill -TERM "$pid" 2>/dev/null
            local c=0
            while check_process "$pid" && [ $c -lt 12 ]; do
                sleep 1
                c=$((c + 1))
            done
            check_process "$pid" && kill -KILL "$pid" 2>/dev/null
        fi
        rm -f "$PID_FILE"
    fi

    # 兜底：PID 文件丢了或指向别处时，端口上残留的也一起清掉
    left="$(orphan_pids "")"
    [ -n "$left" ] && kill_pids "$left"
    wait_port_free || true

    rm -f "$GATEWAY_SOCKET"
    return 0
}

case "$1" in
start) start_process ;;
stop) stop_process ;;
status) if running; then exit 0; else exit 3; fi ;;
*) exit 1 ;;
esac
exit 0
