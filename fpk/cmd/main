#!/bin/bash
# cmd/main — 家庭消息 运行控制
# $1: start / stop / status

APP="$TRIM_APPDEST"
VAR="$TRIM_PKGVAR"
GNOME="${TRIM_PKGHOME:-/vol1/@apphome/family-message}"
LOG="$VAR/family-message.log"
PID_FILE="$VAR/family-message.pid"
PY="$GNOME/venv/bin/python"

export FM_CONFIG="${FM_CONFIG:-$GNOME/config.yaml}"
export FM_DATA_DIR="${FM_DATA_DIR:-$GNOME/data}"
export GATEWAY_SOCKET="${GATEWAY_SOCKET:-$APP/family-message.sock}"
export GATEWAY_PREFIX="${GATEWAY_PREFIX:-/app/family-message}"
export TRIM_SERVICE_PORT="${TRIM_SERVICE_PORT:-18801}"
export PYTHONPATH="$APP/server${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUNBUFFERED=1

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG" 2>/dev/null; }

check_process() {
    local pid=$1
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

running() {
    if [ -f "$PID_FILE" ]; then
        pid=$(head -n1 "$PID_FILE" | tr -d '[:space:]')
        if check_process "$pid"; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

start_process() {
    if running; then return 0; fi

    if [ ! -x "$PY" ]; then
        log "venv 缺失，尝试重建"
        /bin/bash "$APP/../cmd/install_callback" >/dev/null 2>&1 || true
    fi
    if [ ! -x "$PY" ]; then
        echo "Python 运行环境缺失，请在应用中心重新安装本应用。" > "$TRIM_TEMP_LOGFILE"
        return 1
    fi

    log "Starting family-message..."
    mkdir -p "$VAR" "$(dirname "$GATEWAY_SOCKET")"
    rm -f "$GATEWAY_SOCKET"
    cd "$APP/server" || return 1
    nohup "$PY" "$APP/server/run.py" >> "$LOG" 2>&1 &
    echo $! > "$PID_FILE"
    sleep 4
    if check_process "$(cat "$PID_FILE" | tr -d '[:space:]')"; then
        log "family-message started (pid $(cat "$PID_FILE"))"
        return 0
    fi
    log "family-message start FAILED，日志: $LOG"
    echo "家庭消息服务启动失败，请查看日志：$LOG" > "$TRIM_TEMP_LOGFILE"
    return 1
}

stop_process() {
    if [ -f "$PID_FILE" ]; then
        pid=$(head -n1 "$PID_FILE" | tr -d '[:space:]')
        if kill -0 "$pid" 2>/dev/null; then
            log "Stopping family-message (pid $pid)"
            kill -TERM "$pid" 2>/dev/null
            local c=0
            while kill -0 "$pid" 2>/dev/null && [ $c -lt 12 ]; do
                sleep 1; c=$((c+1))
            done
            kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
        fi
        rm -f "$PID_FILE"
    fi
    rm -f "$GATEWAY_SOCKET"
    return 0
}

case "$1" in
start) start_process;;
stop) stop_process;;
status) if running; then exit 0; else exit 3; fi;;
*) exit 1;;
esac
exit 0
